# Optional API targeting (see client/src/services/api.ts).
#
# Local dev (`npm run dev`): defaults to /api → Vite proxy → http://localhost:3000 (no file needed).
#
# Point local UI at hosted API instead:
#   VITE_API_BASE=https://azmarineberg-portal.onrender.com/api
#
# Production (e.g. Vercel): set either
#   VITE_API_URL=https://your-api.onrender.com
# or full base:
#   VITE_API_BASE=https://your-api.onrender.com/api
